# ==============================================================================
# GITTY-AI Environment Configuration Template
# Copy this file to .env and adjust values for your local or production environment.
# DO NOT commit .env with real credentials into source control.
# ==============================================================================

# Environment Mode (development, testing, production)
ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Message Broker & Cache Services
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# ------------------------------------------------------------------------------
# Graph Database Configuration
# GRAPH_MODE: "sqlite" (default local embedded) or "neo4j" (enterprise / container)
# ------------------------------------------------------------------------------
GRAPH_MODE=sqlite
SQLITE_DB_PATH=gitty_graph.db

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-to-a-secure-password

# ------------------------------------------------------------------------------
# Vector Database (Qdrant)
# ------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Embeddings. The default is a real local model. "mock" is deterministic and
# non-semantic; it is never selected automatically and production startup rejects it.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# Hybrid RAG. Vector hits are the seeds. Graph expansion stays inside one repository.
# Depth 2 reaches function -> call -> callee. Raise these only if prompts stay bounded.
RAG_MAX_GRAPH_SEEDS=5
RAG_MAX_GRAPH_DEPTH=2
RAG_MAX_GRAPH_NODES=24
RAG_MAX_GRAPH_RELATIONSHIPS=32

# ------------------------------------------------------------------------------
# LLM Providers Configuration
# LLM_PROVIDER: "ollama", "openai", "gemini", "claude", or "mock"
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=llama3
OLLAMA_URI=http://localhost:11434
CHAT_HISTORY_LIMIT=10

# API Keys (required only when corresponding provider is active)
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# ------------------------------------------------------------------------------
# Local LLM — llama.cpp OpenAI-compatible server (Qwen / any GGUF)
# ------------------------------------------------------------------------------
# Start the server before enabling. Example:
#   llama-server \
#       --model "D:\Evidentia-Models\Qwen3.5-9B-Q4_K_M\Qwen3.5-9B-Q4_K_M.gguf" \
#       --host 127.0.0.1 --port 8080 --ctx-size 8192 --n-predict 1024
#
# The model file path is ONLY used in your server startup command.
# NEVER put the path or the file in this repository.
GITTY_LLM_ENABLED=false
GITTY_LLM_BASE_URL=http://127.0.0.1:8080
GITTY_LLM_MODEL=qwen3.5-9b-q4
GITTY_LLM_TIMEOUT=120

# ------------------------------------------------------------------------------
# API Gateway & Frontend Configuration
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
VITE_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# Architecture Analysis Thresholds
# ------------------------------------------------------------------------------
GITTY_SMELL_FAN_IN_THRESHOLD=10
GITTY_SMELL_FAN_OUT_THRESHOLD=10
GITTY_SMELL_MODULE_SIZE_THRESHOLD=750
