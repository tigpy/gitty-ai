# ==============================================================================
# GITTY-AI Environment Configuration Template
# Copy this file to .env and adjust values for your local or production environment.
# DO NOT commit .env with real credentials into source control.
# ==============================================================================

# Environment Mode (development, testing, production)
ENV=development
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Authentication & Security
# In production, JWT_SECRET_KEY must be a unique, secure secret >= 32 characters.
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change-me-to-a-random-secret-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Message Broker & Cache Services
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# ------------------------------------------------------------------------------
# Graph Database Configuration
# GRAPH_MODE: "sqlite" (default local embedded) or "neo4j" (enterprise / container)
# ------------------------------------------------------------------------------
GRAPH_MODE=sqlite
SQLITE_DB_PATH=gitty_graph.db

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-to-a-secure-password

# ------------------------------------------------------------------------------
# Vector Database (Qdrant)
# ------------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ------------------------------------------------------------------------------
# LLM Providers Configuration
# LLM_PROVIDER: "ollama", "openai", "gemini", "claude", or "mock"
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_MODEL=llama3
OLLAMA_URI=http://localhost:11434
CHAT_HISTORY_LIMIT=10

# API Keys (required only when corresponding provider is active)
OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=

# ------------------------------------------------------------------------------
# API Gateway & Frontend Configuration
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
VITE_API_URL=http://localhost:8000/api/v1

# ------------------------------------------------------------------------------
# Architecture Analysis Thresholds
# ------------------------------------------------------------------------------
GITTY_SMELL_FAN_IN_THRESHOLD=10
GITTY_SMELL_FAN_OUT_THRESHOLD=10
GITTY_SMELL_MODULE_SIZE_THRESHOLD=750
